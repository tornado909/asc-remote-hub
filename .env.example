# FQDN with DNS A/AAAA pointed to your OWN server (real TLS is mandatory).
ASC_HUB_URL=https://hub.example.com
ASC_HUB_DOMAIN=hub.example.com
# Keep loopback if Caddy is on the same Docker host. A trusted LAN reverse proxy
# on another machine needs an address reachable from that proxy.
ASC_BIND_IP=127.0.0.1
ASC_BIND_PORT=18765
# Set to the UID/GID that owns ./data on your host:
PUID=1000
PGID=1000

# Temporary FULL tool-traffic tracing: enable for a single consenting account.
# Full MCP/agent JSON payloads (commands, file text, images) will be recorded.
# Authentication, account registration, cookies, OAuth/device tokens are NEVER recorded.
# IMPORTANT: disable and delete files when debugging is complete.
ASC_HUB_TRACE_PAYLOADS=0
ASC_HUB_TRACE_ACCOUNT=
ASC_HUB_TRACE_MAX_MB=64
ASC_HUB_TRACE_BACKUPS=4

# Trust X-Real-IP only from direct reverse proxies listed here.
# Configure as comma-separated IPs/CIDRs; keep empty otherwise.
ASC_HUB_TRUSTED_PROXIES=
