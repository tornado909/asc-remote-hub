  {
    "name": "move_path",
    "description": "Move a file or directory between two allowed paths. Will not overwrite the destination.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "source": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        },
        "destination": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "source",
        "destination"
      ]
    },
    "annotations": {
