  {
    "name": "run_command",
    "description": "Run a local program WITHOUT a shell, wait up to 120 seconds, return exit code and bounded output. program + args are executed on the connected device. Commands can change files and access the network.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "program": {
          "type": "string",
          "description": "Executable name or path, e.g. python or powershell.exe"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "cwd": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "Timeout",
          "minimum": 1,
          "maximum": 120
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "program"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "start_process",
    "description": "Start a long-running local program without a shell; returns job ID for later reading/stopping.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "program": {
          "type": "string",
          "description": "Executable"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "cwd": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "program"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "read_process",
    "description": "Get bounded stdout/stderr and running status from a process started by this agent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "job_id": {
          "type": "string",
          "description": "Job ID from start_process"
        },
        "offset": {
          "type": "integer",
          "description": "Byte offset",
          "minimum": 0,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "description": "Max bytes",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "job_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "stop_process",
    "description": "Terminate a job created in this agent session (never an arbitrary PID).",
    "inputSchema": {
      "type": "object",
