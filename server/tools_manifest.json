  {
    "name": "run_command",
    "description": "Run a local program WITHOUT a shell, wait up to 120 seconds, return exit code and bounded output. program + args are executed on the connected device. Commands can change files and access the network.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "program": {
          "type": "string",
          "description": "Executable name or path, e.g. python or powershell.exe"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "cwd": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "Timeout",
          "minimum": 1,
          "maximum": 120
