  {
    "name": "click_mouse",
    "description": "Click within the interactive desktop. PyAutoGUI fail-safe is enabled.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "x": {
          "type": "integer",
          "description": "Screen X",
          "minimum": 0,
          "maximum": 20000
        },
        "y": {
          "type": "integer",
          "description": "Screen Y",
          "minimum": 0,
          "maximum": 20000
        },
        "button": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "middle"
          ]
        },
        "clicks": {
          "type": "integer",
          "description": "Number of clicks",
          "minimum": 1,
          "maximum": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "x",
        "y"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "type_text",
