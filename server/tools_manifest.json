  {
    "name": "click_mouse",
    "description": "INTERACTIVE LEGACY FALLBACK only. Physically moves the user's mouse. Disabled without exact already-foreground HWND/PID/title and allow_desktop_interference=true. Prefer window_action.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "hwnd": {
          "type": "integer",
          "description": "HWND from window_list",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expected_pid": {
          "type": "integer",
          "description": "Expected PID",
          "minimum": 1,
          "maximum": 4294967295
        },
        "title_contains": {
          "type": "string",
          "description": "Expected title fragment (>=3 characters)"
        },
        "allow_desktop_interference": {
          "type": "boolean",
          "description": "Explicitly authorize shared user mouse/keyboard interference for THIS call."
        },
        "x": {
          "type": "integer",
          "description": "Screen X",
          "minimum": -32768,
          "maximum": 32767
        },
        "y": {
          "type": "integer",
          "description": "Screen Y",
          "minimum": -32768,
          "maximum": 32767
        },
        "button": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "middle"
          ]
        },
        "clicks": {
          "type": "integer",
          "description": "Clicks",
          "minimum": 1,
          "maximum": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "hwnd",
        "expected_pid",
        "title_contains",
        "allow_desktop_interference",
        "x",
        "y"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
