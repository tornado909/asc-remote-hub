  {
    "name": "scroll_mouse",
    "description": "Scroll at the cursor position; positive values scroll up.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "clicks": {
          "type": "integer",
          "description": "Absolute number of notches",
          "minimum": 1,
          "maximum": 30
        },
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "clicks",
        "direction"
      ]
