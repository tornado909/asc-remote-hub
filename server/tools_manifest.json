      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "max_width": {
          "type": "integer",
          "description": "Downsample width",
          "minimum": 320,
          "maximum": 2400
        }
      },
      "additionalProperties": false,
      "required": [
        "device"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
