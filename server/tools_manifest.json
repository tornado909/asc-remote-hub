[
  {
    "name": "machine_info",
    "description": "Identify this connected computer, its operating system and granted capabilities. Does not read environment secrets.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        }
      },
      "additionalProperties": false,
      "required": [
        "device"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "list_directory",
    "description": "List files and folders inside an allowed directory (max 200 entries).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "path": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        },
        "limit": {
          "type": "integer",
          "description": "Number of entries",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "path"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "stat_path",
