          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "read_file",
    "description": "Read a bounded range of UTF-8 text lines from an allowed file; reports next line offset.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "path": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        },
        "offset": {
          "type": "integer",
          "description": "Zero-based first line",
          "minimum": 0,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "description": "Max lines",
          "minimum": 1,
          "maximum": 500
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "path"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "search_files",
    "description": "Find filenames matching a glob inside an allowed directory; does not follow symlinked directories.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "path": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        },
        "pattern": {
          "type": "string",
          "description": "Filename glob, for example *.py"
        },
        "limit": {
          "type": "integer",
          "description": "Max matches",
          "minimum": 1,
          "maximum": 200
        },
        "depth": {
          "type": "integer",
          "description": "Maximum directory depth",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "path",
        "pattern"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "write_file",
    "description": "Create/append/overwrite UTF-8 text under an allowed root. Overwrite destroys the old content. Maximum 256 KB per call.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "path": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        },
        "text": {
          "type": "string",
          "description": "UTF-8 text to write"
        },
        "mode": {
          "type": "string",
          "enum": [
            "create",
            "append",
            "overwrite"
          ],
          "default": "create"
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "path",
        "text"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
  {
    "name": "replace_text",
    "description": "Replace an exact string in an existing UTF-8 file; fails unless match count equals expected_count.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string",
          "description": "Exact device ID returned by list_devices (only your own devices)."
        },
        "path": {
          "type": "string",
          "description": "Absolute path under ASC_RC_ROOTS"
        },
        "old_text": {
          "type": "string",
          "description": "Exact existing text"
        },
        "new_text": {
          "type": "string",
          "description": "Replacement text"
        },
        "expected_count": {
          "type": "integer",
          "description": "Expected number of replacements",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "path",
        "old_text",
        "new_text"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "remote.access"
        ]
      }
    ]
  },
